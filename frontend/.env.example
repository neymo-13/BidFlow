# Base URL of the Spring Boot backend (REST + WebSocket).
# Default when unset: http://localhost:8080
# Use http://localhost:8081 if you run the backend with a port override (e.g. when 8080 is taken).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google sign-in (optional). OAuth 2.0 Client ID of type "Web application" from Google Cloud Console,
# with http://localhost and http://localhost:3000 as Authorized JavaScript origins.
# Must be the same value as GOOGLE_CLIENT_ID of the backend (root .env). It is public, not a secret.
# Leave empty to hide the "Continue with Google" button. Restart `npm run dev` after changing it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=97133787666-b9cf8btk4rt1punlf3rohgatd7nu5n0p.apps.googleusercontent.com
