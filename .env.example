# Copy to .env (next to docker-compose.yml) and fill in the values.
# .env is gitignored — never commit real values. docker compose reads it automatically
# and passes these variables to the backend container.

# First admin account — set your own in .env (never here). Created when the backend starts
# (or, if the username already exists, that account is made an admin; its password is not changed).
# Leave ADMIN_USERNAME empty to skip. The password must be at least 8 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google sign-in: the team's OAuth 2.0 Client ID (type "Web application"). It is not a secret.
# The frontend needs the same value in frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Empty = Google sign-in is turned off.
GOOGLE_CLIENT_ID=97133787666-b9cf8btk4rt1punlf3rohgatd7nu5n0p.apps.googleusercontent.com
